{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/megabrain11/BusinessCardFieldKit/main/Schemas/classification-output.schema.json",
  "title": "BusinessCardFieldKit Classification Output",
  "type": "object",
  "required": ["contractVersion", "ruleVersions", "alternateNames", "emailAddresses", "mobilePhoneNumbers", "workPhoneNumbers", "faxNumbers", "websites", "professionalProfileURLs", "socialHandles", "addresses", "unclassifiedLines", "warnings", "overallConfidence"],
  "$defs": {
    "evidence": {"enum": ["syntaxMatch", "nearJobTitle", "matchesEmailLocalPart", "emailDomainHint", "precededByMobileLabel", "precededByWorkLabel", "precededByFaxLabel", "organizationSuffix", "organizationVocabulary", "titleVocabulary", "departmentVocabulary", "addressVocabulary", "layoutProminence", "multilingualVariant", "profileHost", "socialPrefix", "localeRulePack", "industryRulePack", "userCorrection"]},
    "candidate": {
      "type": "object",
      "required": ["normalizedValue", "originalValue", "confidence", "evidence", "sourceTokenIdentifiers"],
      "properties": {
        "normalizedValue": {"type": "string"},
        "originalValue": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "alternativeCandidates": {"type": "array", "items": {"type": "object"}},
        "sourceTokenIdentifiers": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "properties": {
    "contractVersion": {"const": "1.0"},
    "ruleVersions": {"type": "array", "items": {"type": "string"}},
    "fullName": {"anyOf": [{"$ref": "#/$defs/candidate"}, {"type": "null"}]},
    "alternateNames": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "preferredName": {"anyOf": [{"$ref": "#/$defs/candidate"}, {"type": "null"}]},
    "jobTitle": {"anyOf": [{"$ref": "#/$defs/candidate"}, {"type": "null"}]},
    "department": {"anyOf": [{"$ref": "#/$defs/candidate"}, {"type": "null"}]},
    "organization": {"anyOf": [{"$ref": "#/$defs/candidate"}, {"type": "null"}]},
    "emailAddresses": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "mobilePhoneNumbers": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "workPhoneNumbers": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "faxNumbers": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "websites": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "professionalProfileURLs": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "socialHandles": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "addresses": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "unclassifiedLines": {"type": "array"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "overallConfidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "additionalProperties": false
}
